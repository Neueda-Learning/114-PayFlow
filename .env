# ============================================
# PayFlow Environment Configuration
# Copy this file to any machine, no changes needed.
# Docker Compose reads these values automatically.
# ============================================

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=flowpay
DB_USER=flowpay
DB_PASSWORD=flowpay123
MYSQL_ROOT_PASSWORD=root123

# Spring Boot
SERVER_PORT=8080

# JWT
JWT_SECRET=payflow-super-secret-key-that-is-at-least-256-bits-long-for-hs256
JWT_EXPIRATION=86400000

# Frontend
VITE_API_URL=http://localhost:8080/api
